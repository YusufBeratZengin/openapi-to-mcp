{
  "openapi": "3.1.0",
  "info": { "title": "Mini", "version": "1.0.0" },
  "servers": [{ "url": "http://127.0.0.1:9/api/" }],
  "paths": {
    "/items": {
      "get": {
        "operationId": "list items!",
        "parameters": [
          { "name": "id", "in": "query", "schema": { "type": ["string", "null"] } },
          { "name": "id", "in": "header", "schema": { "type": "string" } },
          { "name": "ids", "in": "query", "explode": false, "schema": { "type": "array", "items": { "type": "integer" } } },
          { "name": "pipe", "in": "query", "style": "pipeDelimited", "schema": { "type": "array", "items": { "type": "string" } } }
        ],
        "responses": { "200": { "description": "ok" } }
      },
      "post": {
        "parameters": [{ "name": "body", "in": "query", "schema": { "type": "string" } }],
        "requestBody": { "required": true, "description": "The item", "content": { "application/vnd.api+json": { "schema": { "type": "object", "properties": { "a": { "type": "string" } } } } } },
        "responses": { "201": { "description": "created" } }
      }
    },
    "/items/{id}": {
      "get": { "operationId": "list items!", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "ok" } } }
    },
    "/upload": {
      "post": {
        "operationId": "upload",
        "requestBody": { "content": { "multipart/form-data": { "schema": { "type": "object" } } } },
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/big": { "get": { "operationId": "big", "responses": { "200": { "description": "ok" } } } },
    "/redirect": { "get": { "operationId": "redirect", "responses": { "302": { "description": "moved" } } } },
    "/slow": { "get": { "operationId": "slow", "responses": { "200": { "description": "ok" } } } },
    "/text": { "get": { "operationId": "text", "responses": { "200": { "description": "ok" } } } },
    "/whoami": {
      "get": {
        "operationId": "whoami",
        "parameters": [{ "name": "X-Api-Key", "in": "header", "schema": { "type": "string" } }],
        "responses": { "200": { "description": "ok" } }
      }
    }
  }
}
